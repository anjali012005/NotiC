# Copy to .env for local Compose use. Replace every example credential first.
POSTGRES_DB=notifyflow
POSTGRES_USER=notifyflow
POSTGRES_PASSWORD=replace-with-a-local-database-password

RABBITMQ_DEFAULT_USER=notifyflow
RABBITMQ_DEFAULT_PASS=replace-with-a-local-rabbitmq-password

# The legacy tenant is seeded by migration V16. Use your own key locally.
SPRING_APPLICATION_JSON='{"notifyflow":{"security":{"api-keys":{"00000000-0000-0000-0000-000000000000":"replace-with-a-long-random-api-key"}}}}'

# Optional. Leave empty to prevent real provider dispatch during local development.
SENDGRID_API_KEY=