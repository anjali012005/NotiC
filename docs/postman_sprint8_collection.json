    {
      "name": "Retry Mechanism",
      "item": [
        {
          "name": "Retry Failed Notification",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8081/api/v1/notifications/{{notificationId}}/retry",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "notifications", "{{notificationId}}", "retry"]
            },
            "description": "Retry a failed notification. Replace {{notificationId}} with actual ID of a FAILED notification. Should increment retryCount and change status to SENT on success."
          },
          "response": []
        },
        {
          "name": "Retry Beyond Max Retries",
          "request": {
            "method": "POST",
            "header": [],
