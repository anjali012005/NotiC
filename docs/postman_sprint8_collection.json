  "item": [
    {
      "name": "Provider Management (Bug Fix Test)",
      "item": [
        {
          "name": "Create Provider with isDefault=true",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TestSendGrid\",\n  \"channel\": \"EMAIL\",\n  \"providerType\": \"SENDGRID\",\n  \"config\": \"{\\\"apiKey\\\":\\\"SG.test123\\\"}\",\n  \"enabled\": true,\n  \"isDefault\": true\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/providers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "providers"]
            },
            "description": "Test the isDefault boolean bug fix. This should persist is_default=true in PostgreSQL and return isDefault:true in response."
          },
          "response": []
        },
        {
          "name": "Create Provider with isDefault=false",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TestMailgun\",\n  \"channel\": \"EMAIL\",\n  \"providerType\": \"SMTP\",\n  \"config\": \"{\\\"host\\\":\\\"smtp.mailgun.org\\\",\\\"port\\\":587}\",\n  \"enabled\": true,\n  \"isDefault\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8081/api/v1/providers",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8081",
              "path": ["api", "v1", "providers"]
            },
            "description": "Test that isDefault=false is also persisted correctly."
          },
          "response": []
        }
      ]
    },
