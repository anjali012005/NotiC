{
  "info": {
    "name": "NotifyFlow Sprint 10 - Asynchronous Processing",
    "description": "Creates a notification, verifies the immediate 202/QUEUED response, and lets you inspect its background delivery state.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Queue notification (202 Accepted)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"templateKey\": \"WELCOME_EMAIL\",\n  \"recipient\": \"{{recipient}}\",\n  \"variables\": {\"name\": \"Jane\"}\n}"},
        "url": "{{baseUrl}}/api/v1/notifications/send"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('request is accepted', () => pm.response.to.have.status(202));",
        "const response = pm.response.json();",
        "pm.test('notification is queued', () => pm.expect(response.status).to.eql('QUEUED'));",
        "pm.collectionVariables.set('notificationId', response.id);"
      ]}}],
      "response": []
    },
    {
      "name": "Get notification status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('returns a tracked notification', () => pm.response.to.have.status(200));",
        "pm.test('has a lifecycle status', () => pm.expect(pm.response.json().status).to.be.oneOf(['QUEUED', 'PROCESSING', 'SENT', 'FAILED']));"
      ]}}],
      "response": []
    },
    {
      "name": "Retry failed notification (202 Accepted)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/notifications/{{notificationId}}/retry"
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('retry is accepted or rejected by lifecycle rules', () => pm.expect(pm.response.code).to.be.oneOf([202, 400]));"
      ]}}],
      "response": []
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081"},
    {"key": "recipient", "value": "user@example.com"},
    {"key": "notificationId", "value": ""}
  ]
}
