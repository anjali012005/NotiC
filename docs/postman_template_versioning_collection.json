{
    "info": {
        "name": "NotifyFlow Template Versioning",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "version": "1.0.0"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080/api/v1/templates"
        }
    ],
    "item": [
        {
            "name": "Create Template",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"templateKey\": \"welcome_email\",\n  \"name\": \"Welcome Email\",\n  \"channel\": \"EMAIL\",\n  \"subject\": \"Welcome, {{firstName}}\",\n  \"body\": \"Hello {{firstName}}, welcome to our service.\",\n  \"tags\": [\"onboarding\"]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}",
                    "host": [
                        "{{baseUrl}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Created', function() { pm.response.to.have.status(201); });",
                            "const body = pm.response.json(); pm.collectionVariables.set('templateId', body.id);"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Update Template (creates new version)",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Welcome Email Updated\",\n  \"channel\": \"EMAIL\",\n  \"subject\": \"Welcome, {{firstName}} (v2)\",\n  \"body\": \"Hello {{firstName}}, welcome v2.\",\n  \"tags\": [\"onboarding\"]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/{{templateId}}",
                    "host": [
                        "{{baseUrl}}/{{templateId}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('OK', function() { pm.response.to.have.status(200); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Create Version (explicit)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"subject\": \"Welcome, {{firstName}} (manual)\",\n  \"body\": \"Hello {{firstName}}, manual version.\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/{{templateId}}/versions",
                    "host": [
                        "{{baseUrl}}/{{templateId}}/versions"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Created', function() { pm.response.to.have.status(201); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Versions (history)",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/{{templateId}}/versions",
                    "host": [
                        "{{baseUrl}}/{{templateId}}/versions"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('OK', function() { pm.response.to.have.status(200); });",
                            "const v = pm.response.json(); pm.test('Has versions', () => pm.expect(v.length).to.be.above(0));"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Specific Version",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/{{templateId}}/versions/1",
                    "host": [
                        "{{baseUrl}}/{{templateId}}/versions/1"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('OK', function() { pm.response.to.have.status(200); });"
                        ]
                    }
                }
            ]
        },
        {
            "name": "Get Invalid Version (404)",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "{{baseUrl}}/{{templateId}}/versions/9999",
                    "host": [
                        "{{baseUrl}}/{{templateId}}/versions/9999"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Not Found', function() { pm.response.to.have.status(404); });"
                        ]
                    }
                }
            ]
        }
    ]
}